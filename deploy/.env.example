# Tribo deployment settings: copy to .env (never committed) and set the values for your mode.
# Modes and the secrets each one needs: docs/runbook.md and docs/design/sprint-0.md.

# Release tag of the tribo-app and tribo-proxy images to run, e.g. v0.1.0.
TRIBO_VERSION=

# The one public origin, https only, e.g. https://trips.example.com.
TRIBO_PUBLIC_URL=

# acme-http (default), acme-dns-cloudflare, origin-cert or internal.
TRIBO_TLS_MODE=acme-http

# Let's Encrypt account contact; required for acme-http and acme-dns-cloudflare.
TRIBO_ACME_EMAIL=

# Whose forwarded client IP to believe: none (default), cloudflare, or a comma-separated
# CIDR list of your own proxies.
TRIBO_TRUSTED_PROXIES=none

# tunnel adds the cloudflared service (Cloudflare Tunnel mode); empty otherwise.
COMPOSE_PROFILES=

# fatal, error, warn, info (default), debug or trace.
TRIBO_LOG_LEVEL=info
