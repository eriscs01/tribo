# The oldest Docker Engine and Compose that run compose.yml, read by docker-check.sh and by
# CI, whose "End to end" job runs the stack on exactly these versions.
# Engine 29.1.4: mounting one image twice (the db's bootstrap and migrations), moby/moby#50268
# in 29.0.0, and image mounts no longer failing with "file name too long", moby/moby#51829.
# Compose 2.35.0: `type: image` volumes, docker/compose#12725.
DOCKER_ENGINE_MIN=29.1.4
DOCKER_COMPOSE_MIN=2.35.0
