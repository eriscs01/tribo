# Settings for pull.sh and restore.sh on your own machine: copy to ~/.config/tribo/backup.env.
# Paths only; no secret goes in this file.

# ssh destination of the host for the backup key: a Host alias in ~/.ssh/config (runbook step 10).
TRIBO_BACKUP_HOST=tribo-backup

# Directory on a disk you own that holds the snapshots, e.g. /Volumes/Backup/tribo.
TRIBO_BACKUP_DIR=

# Snapshots kept (the newest ones).
TRIBO_BACKUP_KEEP=7

# rsync 3 for the upload sync; the host's rrsync refuses macOS's own openrsync. On macOS:
# brew install rsync, then /opt/homebrew/bin/rsync. On Linux, rsync is rsync 3.
TRIBO_RSYNC=rsync

# restore.sh only: your copy of the app key (runbook step 7), e.g. exported from your password
# manager to an encrypted disk. Without it the scratch app cannot read sensitive fields.
TRIBO_APP_KEY_FILE=

# restore.sh only: local port of the scratch project, https://restore.tribo.localhost:<port>.
TRIBO_RESTORE_PORT=8443
