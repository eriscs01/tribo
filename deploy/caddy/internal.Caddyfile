# TRIBO_TLS_MODE=internal: Caddy's own CA (root in the caddy_data volume); for private LAN or
# VPN hosts and the Cloudflare Tunnel.
{
	local_certs
	# The root stays in the volume; clients that should trust it import it (docs/runbook.md).
	skip_install_trust
	servers {
		import trusted-proxies/{$TRIBO_PROXY_KIND}.caddy
	}
}

{$TRIBO_PUBLIC_URL} {
	import site.caddy
}
