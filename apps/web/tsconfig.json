{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Type output only; Vite writes the app itself to dist/app.
    "outDir": "dist/types",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/contract"
    }
  ]
}
