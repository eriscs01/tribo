# Build context for deploy/app/Dockerfile and deploy/caddy/Dockerfile (both built from the
# repo root). The images install and build from source, so local output never goes in, and
# secrets and env files never leave the machine.
.git
.claude
**/node_modules
**/dist
**/*.tsbuildinfo
**/coverage
**/.env
**/.env.*
deploy/secrets
secrets
*.dump
*.sql.gz
playwright-report
test-results
